# Files executed or read inside the Linux container must keep LF line endings,
# even in a Windows checkout with core.autocrlf=true (a CRLF shebang makes
# `/bin/sh\r` "not found" at build time).
*.sh        text eol=lf
*.txt       text eol=lf
Dockerfile  text eol=lf
# Windows batch files need CRLF (labels and goto misbehave with LF)
*.cmd       text eol=crlf
# The Linux/macOS wrapper runs in sh
hd          text eol=lf
