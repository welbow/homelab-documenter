# Copy to .env (gitignored) and fill in. Never commit .env.
#
# Bitwarden personal API key, used by the BitwardenPasswords plugin to run
# `bw login --apikey`. It only authenticates: the vault stays encrypted
# until it is unlocked with the master password.
#
# To view or regenerate the key (e.g. if it leaks):
#   1. Log in to your Bitwarden web vault (the plugin's server_url).
#   2. Settings -> Security -> Keys -> API Key.
#   3. "View API key" to copy the current one, or "Rotate API key" to
#      invalidate the old key and issue a new one (needs the master password).
#   4. Paste client_id and client_secret below.
BW_CLIENTID=
BW_CLIENTSECRET=

# Log level: DEBUG, INFO, WARNING or ERROR. Overrides "log_level" in
# config.json; with neither set, runs log at INFO. Uncomment DEBUG while
# developing (it shows the config, with secrets masked).
# LOG_LEVEL=DEBUG

# Plugins to skip while developing, e.g. the slow Bitwarden and nmap
# ones: numbers (500), directories (500-bitwarden-passwords) or class names
# (BitwardenPasswords), comma-separated. Each skipped plugin is logged as a
# warning, and the output of such a run is incomplete. 001 (the config
# loader) is never skipped. One-off alternative:
#   docker compose run --rm builder --skip 500
# SKIP_PLUGINS=500,100

# Time zone for the "Generated ..." stamp on every page (default UTC).
# TZ=America/New_York
