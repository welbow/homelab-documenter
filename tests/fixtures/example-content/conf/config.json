{
    "log_level": "INFO",
    "plugins": {
        "StaticFile": {
            "enabled": 1,
            "files": [
                {"seq_number": "002", "title": "", "file": "confidential.html", "hide_surround": 1},
                {"seq_number": "010", "title": "Start Here", "file": "start-here.html"},
                {"seq_number": "020", "title": "Getting Into the File Server", "file": "file-server.html"},
                {"seq_number": "030", "title": "Network Notes", "file": "network-notes.txt"}
            ]
        },
        "HostOverrides": {
            "enabled": 1
        },
        "NmapPingScan": {
            "enabled": 0,
            "subnets": [
                "192.0.2.0/24"
            ]
        },
        "MSDHCP": {
            "enabled": 0,
            "mode": "winrm",
            "server": "dc1.example.com"
        },
        "CiscoSwitches": {
            "enabled": 0,
            "switches": [{"host": "192.0.2.11"}, {"host": "192.0.2.12"}]
        },
        "OPNsense": {
            "enabled": 0,
            "url": "https://192.0.2.1",
            "ca_file": "opnsense-ca.pem",
