        },
        "BitwardenPasswords": {
            "enabled": 0,
            "server_url": "https://vault.example.com",
            "queries": [
                {
                    "title": "Appendix B - Passwords",
                    "header": "Every item in the vault",
                    "seq_number": "960"
                }
            ]
        },
        "PortMap": {
            "section": {"title": "Appendix C - Switch Ports", "seq_number": "970"}
        },
        "OutputHostInfo": {
            "enabled": 1,
            "title": "Appendix A - Devices",
            "header": "Devices on the network, and what to do with them",
            "seq_number": "950"
        },
        "OutputCredInfo": {
            "enabled": 1
        },
        "TableOfContents": {
            "enabled": 1,
            "seq_number": "005",
            "title": "Contents"
        },
        "HTMLOutput": {
            "enabled": 1,
            "outputfile": "homelab-packet-{date}.html",
            "stylesheets": [
                "standard.css"
            ]
        }
    }
